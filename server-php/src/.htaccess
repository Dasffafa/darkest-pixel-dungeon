RewriteEngine On
RewriteBase /

# Mitigate multipart/form-data upload abuse (API only accepts JSON or gzip)
RewriteCond %{HTTP:Content-Type} multipart/form-data [NC]
RewriteRule ^ - [F,L]

# Block direct access to internal PHP configuration and library files
RewriteRule ^api/(config(\.sample)?|lib)\.php$ - [F,L]

# API endpoints (served by api/index.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/ api/index.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^health$ api/index.php [QSA,L]

# Apex homepage -> ICP filing page (subdomain keeps the game site at /)
RewriteCond %{HTTP_HOST} ^(www\.)?crystaldragons\.top$ [NC]
RewriteRule ^$ filing/index.html [L]

# Revalidate static assets instead of letting browsers serve stale copies
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
